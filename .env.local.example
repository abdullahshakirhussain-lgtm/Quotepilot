# ---------------------------------------------------------------------------
# QuotePilot environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# These are baked into the build: after changing them, rebuild/redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Business time zone used for "due today", "overdue", reminder dates and the
# dashboard greeting. Hosts like Railway run in UTC, so without this "today"
# flips at UTC midnight (05:30 in Sri Lanka, 17:00 in California).
# Any IANA name, e.g. Asia/Colombo, America/New_York, Europe/London.
APP_TIMEZONE=

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL).
# If no key is set, QuotePilot falls back to built-in message templates,
# so the app is fully demoable without any AI credentials.
# Priority order if several are set: Anthropic > DeepSeek > OpenAI.
#
# Option A — DeepSeek (recommended: just set this one variable)
# Endpoint + model are built in (https://api.deepseek.com, deepseek-chat).
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional overrides:
# AI_MODEL=deepseek-chat            # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# Option B — Anthropic (Claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Option C — Any other OpenAI-compatible endpoint (OpenAI, Groq, Together…)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
