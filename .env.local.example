# ---------------------------------------------------------------------------
# QuotePilot environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL).
# If no key is set, QuotePilot falls back to built-in message templates,
# so the app is fully demoable without any AI credentials.
#
# Option A — Anthropic (default when ANTHROPIC_API_KEY is present)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-haiku-4-5-20251001 (fast + cheap).
# AI_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Option B — Any OpenAI-compatible endpoint (used only if ANTHROPIC_API_KEY is empty)
# Works with OpenAI, Groq, Together, OpenRouter, local LLMs, etc.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
