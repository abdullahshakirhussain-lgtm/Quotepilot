# ---------------------------------------------------------------------------
# QuoteLoop environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# These are baked into the build: after changing them, rebuild/redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Deployment fallback time zone (server-side, optional).
# QuoteLoop computes "today", due and overdue in each viewer's own browser
# time zone. This value is only used before that is known (e.g. a user's very
# first request) — it is NOT a business setting and does not change anyone's
# time zone. Keep UTC for a global deployment, or set your primary market /
# demo operator's zone. Any IANA name, e.g. America/New_York, Europe/London.
APP_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Email sending (OPTIONAL) — manual, 1-to-1 follow-ups from the AI assistant.
# Needs a Resend account with a VERIFIED sending domain. Without these, the
# Send email button is hidden and users copy messages instead.
# Nothing is ever sent automatically; each email needs an explicit click.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# An address on your verified domain, e.g. QuoteLoop <followups@yourdomain.com>
EMAIL_FROM=
# Optional Reply-To when the business profile has no email address.
EMAIL_REPLY_TO=

# Google sign-in needs no variables here — it is configured in Supabase
# (Auth -> Providers -> Google). See README "Google sign-in".

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL).
# If no key is set, QuoteLoop falls back to built-in message templates,
# so the app is fully demoable without any AI credentials.
# Priority order if several are set: Anthropic > DeepSeek > OpenAI.
#
# Option A — DeepSeek (recommended: just set this one variable)
# Endpoint + model are built in (https://api.deepseek.com, deepseek-chat).
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional overrides:
# AI_MODEL=deepseek-chat            # or deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# Option B — Anthropic (Claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Option C — Any other OpenAI-compatible endpoint (OpenAI, Groq, Together…)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
